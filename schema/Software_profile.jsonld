{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "codemeta": "https://w3id.org/codemeta/",
    "fair4ml": "https://w3id.org/fair4ml#",
    "bioschemas": "https://bioschemas.org/",
    "maSMP": "https://discovery.biothings.io/view/maSMP/",
    "connoss": "https://discovery.biothings.io/ns/connoss/"
  },
  "@graph": [
    {
      "@id": "connoss:SoftwareProfile",
      "@type": "rdfs:Class",
      "rdfs:comment": "Profile for Software type.",
      "rdfs:label": "Software Profile",
      "rdfs:subClassOf": [
        {
          "@id": "connoss:Software"
        }
      ],
      "schema:license": {
        "@id": "https://creativecommons.org/licenses/by-sa/4.0/"
      },
      "schema:schemaVersion": "https://schema.org/docs/releases.html#v29.4"
    },
    {
      "@id": "schema:codeRepository",
      "@type": "rdf:Property",
      "rdfs:comment": "Link to the version control system where the software is developed and maintained (e.g. SVN, GitHub, CodePlex, institutional GitLab instance, etc.).",
      "rdfs:label": "code repository",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "schema:codeSampleType",
      "@type": "rdf:Property",
      "rdfs:comment": "The classification of the provided source code sample, indicating its completeness, execution readiness, and intended use case. Expected Values: full solution (or compile ready/executable), code snippet, inline code, script, template.",
      "rdfs:label": "code sample type",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:programmingLanguage",
      "@type": "rdf:Property",
      "rdfs:comment": "The computer programming languages used to write the software or source code.",
      "rdfs:label": "programming language",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:ComputerLanguage"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "schema:runtimePlatform",
      "@type": "rdf:Property",
      "rdfs:comment": "The execution environment required to run the software, including script interpreters (e.g., Python 3.9), virtual machines (e.g., Java Virtual Machine v17), and managed frameworks (e.g., .NET Core 6.0).",
      "rdfs:label": "runtime platform",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:targetProduct",
      "@type": "rdf:Property",
      "rdfs:comment": "The specific operating system, platform, or parent software application to which the code or software applies, indicating compatibility or a target ecosystem (e.g., Linux, Windows 11, WordPress, MATLAB). If the software is compatible across multiple versions, the general product name can be used alone.",
      "rdfs:label": "target product",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:SoftwareApplication"
      }
    },
    {
      "@id": "schema:applicationCategory",
      "@type": "rdf:Property",
      "rdfs:comment": "The high-level functional classification of the software application, indicating its primary computational purpose or technical utility (e.g., Simulation, Data Visualization, Statistical Analysis).",
      "rdfs:label": "application category",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "schema:applicationSubCategory",
      "@type": "rdf:Property",
      "rdfs:comment": "A more granular technical or computational classification of the software (e.g., Agent-Based Modeling as a subcategory of Simulation & Modeling).",
      "rdfs:label": "application subcategory",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "schema:applicationSuite",
      "@type": "rdf:Property",
      "rdfs:comment": "The name of the overarching software suite, distribution, or cohesive ecosystem to which the individual software application belongs.",
      "rdfs:label": "application suite",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:availableOnDevice",
      "@type": "rdf:Property",
      "rdfs:comment": "The specific hardware device, architecture, or machine model required to execute the software. This property is used when the software cannot run on standard generic hardware and explicitly depends on specialized physical machinery, processors, or laboratory equipment.",
      "rdfs:label": "available on device",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:countriesNotSupported",
      "@type": "rdf:Property",
      "rdfs:comment": "The list of countries where the software application is not supported, cannot be legally distributed, or is technically restricted from operating.",
      "rdfs:label": "countries not supported",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:countriesSupported",
      "@type": "rdf:Property",
      "rdfs:comment": "The list of countries where the software application is explicitly supported, verified to work, or legally cleared for distribution.",
      "rdfs:label": "countries supported",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:downloadUrl",
      "@type": "rdf:Property",
      "rdfs:comment": "The direct URL from which the software binary, compiled package, executable, or compressed distribution archive (e.g., .tar.gz, .whl, .exe, .dmg) can be downloaded.",
      "rdfs:label": "download url",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "schema:featureList",
      "@type": "rdf:Property",
      "rdfs:comment": "A list of the core functionalities or modules provided by the software, including components that external pipelines or applications can depend upon.",
      "rdfs:label": "feature list",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "schema:fileSize",
      "@type": "rdf:Property",
      "rdfs:comment": "The total digital size of the downloadable software package or binary. In the absence of an explicit unit (e.g. MB or KB), the value is assumed to be KB.",
      "rdfs:label": "file size",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:installUrl",
      "@type": "rdf:Property",
      "rdfs:comment": "URL at which the app may be installed, if different from the URL of the item.",
      "rdfs:label": "install url",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "schema:operatingSystem",
      "@type": "rdf:Property",
      "rdfs:comment": "The operating system(s) required to execute the software (e.g. Windows 7, OSX 10.6, Android 1.6).",
      "rdfs:label": "operating system",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:permissions",
      "@type": "rdf:Property",
      "rdfs:comment": "The explicit security privileges, access rights, or network authorizations required by the software to execute its functions successfully.",
      "rdfs:label": "permissions",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:processorRequirements",
      "@type": "rdf:Property",
      "rdfs:comment": "Processor architecture required to run the application (e.g. IA64).",
      "rdfs:label": "processor requirements",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:releaseNotes",
      "@type": "rdf:Property",
      "rdfs:comment": "Description of what changed in this version.",
      "rdfs:label": "release notes",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "schema:screenshot",
      "@type": "rdf:Property",
      "rdfs:comment": "A URL pointing to an image demonstrating the software's user interface, command-line execution, or visual data output.",
      "rdfs:label": "release notes",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:ImageObject"
        }
      ]
    },
    {
      "@id": "schema:softwareAddOn",
      "@type": "rdf:Property",
      "rdfs:comment": "A software application, plugin, extension, or module that extends the functionality of the primary application.",
      "rdfs:label": "software add-on",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:SoftwareApplication"
      }
    },
    {
      "@id": "schema:softwareHelp",
      "@type": "rdf:Property",
      "rdfs:comment": "User guides, manuals, wikis, or help center pages that assist users in configuring and operating the software.",
      "rdfs:label": "software help",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "schema:softwareRequirements",
      "@type": "rdf:Property",
      "rdfs:comment": "External software components, libraries, frameworks, or runtime environments required for the application to function.",
      "rdfs:label": "software requirements",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:SoftwareSourceCode"
      }
    },
    {
      "@id": "schema:softwareVersion",
      "@type": "rdf:Property",
      "rdfs:comment": "Version of the software instance.",
      "rdfs:label": "software version",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:storageRequirements",
      "@type": "rdf:Property",
      "rdfs:comment": "The minimum amount of persistent storage (disk space) required to install and execute the software.",
      "rdfs:label": "storage requirements",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "schema:supportingData",
      "@type": "rdf:Property",
      "rdfs:comment": "Reference datasets, auxiliary data streams, or data feeds that are bundled with, or required by the software.",
      "rdfs:label": "supporting data",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:DataFeed"
      }
    },
    {
      "@id": "schema:author",
      "@type": "rdf:Property",
      "rdfs:comment": "The person or organization that created the software.",
      "rdfs:label": "author",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Organization"
        },
        {
          "@id": "schema:Person"
        }
      ]
    },
    {
      "@id": "schema:citation",
      "@type": "rdf:Property",
      "rdfs:comment": "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc.",
      "rdfs:label": "citation",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "schema:contributor",
      "@type": "rdf:Property",
      "rdfs:comment": "The person or organization that provided secondary contributions to the software.",
      "rdfs:label": "contributor",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Organization"
        },
        {
          "@id": "schema:Person"
        }
      ]
    },
    {
      "@id": "schema:copyrightHolder",
      "@type": "rdf:Property",
      "rdfs:comment": "The person or organization that holds the legal copyright and intellectual property rights to the software application.",
      "rdfs:label": "copyright holder",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Organization"
        },
        {
          "@id": "schema:Person"
        }
      ]
    },
    {
      "@id": "schema:copyrightYear",
      "@type": "rdf:Property",
      "rdfs:comment": "The year during which the claimed copyright for the software application was first asserted.",
      "rdfs:label": "copyright year",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Number"
      }
    },
    {
      "@id": "schema:dateCreated",
      "@type": "rdf:Property",
      "rdfs:comment": "The date on which the software application repository or initial source code project was first created.",
      "rdfs:label": "date created",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Date"
      }
    },
    {
      "@id": "schema:dateModified",
      "@type": "rdf:Property",
      "rdfs:comment": "The date on which the software application, source code repository, or specific release metadata was last updated or changed.",
      "rdfs:label": "date modified",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Date"
      }
    },
    {
      "@id": "schema:datePublished",
      "@type": "rdf:Property",
      "rdfs:comment": "The date on which this specific version or release of the software application was officially made publicly available.",
      "rdfs:label": "date published",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Date"
      }
    },
    {
      "@id": "schema:encodingFormat",
      "@type": "rdf:Property",
      "rdfs:comment": "The media type, serialization format, or specific data profile used to represent the software application or its associated packages.",
      "rdfs:label": "encoding format",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "schema:funder",
      "@type": "rdf:Property",
      "rdfs:comment": "A person or organization that supports the development and maintenance of the software through financial contributions, grants, or sponsorships.",
      "rdfs:label": "funder",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Organization"
        },
        {
          "@id": "schema:Person"
        }
      ]
    },
    {
      "@id": "schema:hasPart",
      "@type": "rdf:Property",
      "rdfs:comment": "Indicates a distinct creative work, component, or sub-module that is contained within this software application.",
      "rdfs:label": "has part",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "schema:isAccessibleForFree",
      "@type": "rdf:Property",
      "rdfs:comment": "A flag to signal that the publication is accessible for free.",
      "rdfs:label": "is accessible for free",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Boolean"
      }
    },
    {
      "@id": "schema:isPartOf",
      "@type": "rdf:Property",
      "rdfs:comment": "Indicates a larger software ecosystem or overarching project that this software application is a sub-module, component, or integrated piece of.",
      "rdfs:label": "is part of",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "schema:keywords",
      "@type": "rdf:Property",
      "rdfs:comment": "Keywords, tags, or terms that describe the software application.",
      "rdfs:label": "keywords",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:license",
      "@type": "rdf:Property",
      "rdfs:comment": "The legal license that governs the copying, modification, distribution, and execution of the software application, typically indicated by URL.",
      "rdfs:label": "license",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "schema:publisher",
      "@type": "rdf:Property",
      "rdfs:comment": "The person or organization responsible for making the software application publicly available, distributing it, or managing its official archival publication.",
      "rdfs:label": "publisher",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Organization"
        },
        {
          "@id": "schema:Person"
        }
      ]
    },
    {
      "@id": "schema:review",
      "@type": "rdf:Property",
      "rdfs:comment": "An evaluation, critique, or formal assessment of the software application",
      "rdfs:label": "review",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Review"
      }
    },
    {
      "@id": "schema:sponsor",
      "@type": "rdf:Property",
      "rdfs:comment": "A person or organization that provides promotional, logistical, institutional, or financial backing for the software, often through an ongoing partnership, pledge, or endorsement.",
      "rdfs:label": "sponsor",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Organization"
        },
        {
          "@id": "schema:Person"
        }
      ]
    },
    {
      "@id": "schema:description",
      "@type": "rdf:Property",
      "rdfs:comment": "A short, clear text abstract or summary that describes what the software application does and its key features.",
      "rdfs:label": "description",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:identifier",
      "@type": "rdf:Property",
      "rdfs:comment": "A unique, unambiguous string, URL, or token that permanently and globally identifies the software application or a specific version of it, such as ISBNs, GTINs, UUIDs etc.",
      "rdfs:label": "identifier",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:PropertyValue"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "schema:name",
      "@type": "rdf:Property",
      "rdfs:comment": "The name of the item (software, Organization)",
      "rdfs:label": "name",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:sameAs",
      "@type": "rdf:Property",
      "rdfs:comment": "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the item's Wikipedia page, Wikidata entry, or official website.",
      "rdfs:label": "same as",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "schema:url",
      "@type": "rdf:Property",
      "rdfs:comment": "URL of the item.",
      "rdfs:label": "url",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "schema:relatedLink",
      "@type": "rdf:Property",
      "rdfs:comment": "A link related to this object, e.g. related web pages",
      "rdfs:label": "related link",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:buildInstructions",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to the specific documentation, scripts, or instructions required to compile, build, or install the software application.",
      "rdfs:label": "build instructions",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:CreativeWork"
        }
      ]
    },
    {
      "@id": "codemeta:continuousIntegration",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to the continuous integration (CI) service or build automation platform.",
      "rdfs:label": "continuous integration",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:developmentStatus",
      "@type": "rdf:Property",
      "rdfs:comment": "A term describing the current maintenance and lifecycle status of the software application (e.g., active, inactive, suspended).",
      "rdfs:label": "development status",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "codemeta:embargoEndDate",
      "@type": "rdf:Property",
      "rdfs:comment": "Software may be embargoed from public access until a specified date (e.g. pending publication, 1 year from publication)",
      "rdfs:label": "embargo end date",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Date"
      }
    },
    {
      "@id": "schema:funding",
      "@type": "rdf:Property",
      "rdfs:comment": "A specific grant, award, or financial assistance program that funded the development or maintenance of the software application.",
      "rdfs:label": "funding",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "codemeta:hasSourceCode",
      "@type": "rdf:Property",
      "rdfs:comment": "Link that states where the software code is for a given software. For example a software registry may indicate that one of its software entries hasSourceCode in a GitHub repository.",
      "rdfs:label": "has source code",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:SoftwareSourceCode"
      }
    },
    {
      "@id": "codemeta:isSourceCodeOf",
      "@type": "rdf:Property",
      "rdfs:comment": "Link that states where software application is built from a given source code. This is the reverse property of 'hasSourceCode'.",
      "rdfs:label": "is source code of",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:SoftwareApplication"
      }
    },
    {
      "@id": "codemeta:issueTracker",
      "@type": "rdf:Property",
      "rdfs:comment": "link to software bug reporting or issue tracking system.",
      "rdfs:label": "issue tracker",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:readme",
      "@type": "rdf:Property",
      "rdfs:comment": "link to software Readme file",
      "rdfs:label": "readme",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:referencePublication",
      "@type": "rdf:Property",
      "rdfs:comment": "An academic publication related to the software.",
      "rdfs:label": "reference publication",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": {
        "@id": "schema:ScholarlyArticle"
      }
    },
{
  "@id": "codemeta:relatedSoftware",
  "@type": "rdf:Property",
  "rdfs:label": "related software",
  "rdfs:comment": "A link to other software that is related by functionality, scientific purpose, or ecosystem context (e.g. alternative implementations, comparable tools, or complementary software). This property does not imply dependency, citation, or execution requirement. It is intended to support discovery, comparison, and interoperability mapping between software artifacts.",
  "schema:domainIncludes": {
    "@id": "codemeta:Software"
  },
  "schema:rangeIncludes": [
    {
      "@id": "schema:SoftwareSourceCode"
    },
    {
      "@id": "schema:SoftwareApplication"
    }
  ]
},
{
  "@id": "schema:contactPoint",
  "@type": "rdf:Property",
  "rdfs:label": "contactPoint",
  "rdfs:comment": "A contact point for this resource.",
  "schema:domainIncludes": {
    "@id": "codemeta:Software"
  },
  "schema:rangeIncludes": {
    "@id": "schema:ContactPoint"
  }
},
{
  "@id": "schema:creditText",
  "@type": "rdf:Property",
  "rdfs:label": "creditText",
  "rdfs:comment": "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work.",
  "schema:domainIncludes": {
    "@id": "codemeta:Software"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  }
},
{
  "@id": "schema:alternateName",
  "@type": "rdf:Property",
  "rdfs:label": "alternateName",
  "rdfs:comment": "An alias for the resource.",
  "schema:domainIncludes": {
    "@id": "codemeta:Software"
  },
  "schema:rangeIncludes": {
    "@id": "schema:Text"
  }
},
{
      "@id": "fair4ml:intendedUse",
      "@type": "rdf:Property",
      "rdfs:comment": "A concise summary of the primary objective or intended use case for the software. Distinct from general description; this focuses on 'why' the software exists and what problems it solves.",
      "rdfs:label": "intended use",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "fair4ml:legalConsiderations",
      "@type": "rdf:Property",
      "rdfs:comment": "A documented concern, requirement, or consideration related to the software's design, deployment, or impact across legal and regulatory dimensions (e.g. licensing constraints, data protection, compliance requirements). Enables transparent disclosure of legal constraints and mitigation strategies.",
      "rdfs:label": "legal considerations",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "fair4ml:ethicalSocialConsiderations",
      "@type": "rdf:Property",
      "rdfs:comment": "A documented concern, requirement, or consideration related to the software's design, deployment, or impact across ethical and social dimensions. Enables transparent disclosure of constraints and mitigation strategies.",
      "rdfs:label": "ethical social considerations",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ]
    },
    {
      "@id": "connoss:applicationDomain",
      "@type": "rdf:Property",
      "rdfs:comment": "The discipline, area, or research/application domain to which this software aligns or belongs to.",
      "rdfs:label": "application domain",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {"@id": "schema:DefinedTerm"},
        { "@id": "schema:Text" },
        { "@id": "schema:URL" }
      ]
    },
    {
      "@id": "connoss:documentation",
      "@type": "rdf:Property",
      "rdfs:comment": "Resources that describe the software's installation, usage, configuration, development, and deployment intended to support users and developers in understanding and applying the software.",
      "rdfs:label": "documentation",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:CreativeWork"
        }
      ]
    },
    {
  "@id": "connoss:userDocumentation",
  "@type": "rdf:Property",
  "rdfs:comment": "Documentation for end users of the software.",
  "rdfs:label": "user documentation",
  "rdfs:subPropertyOf": {
    "@id": "connoss:documentation"
  },
  "schema:domainIncludes": {
    "@id": "connoss:Software"
  },
  "schema:rangeIncludes": [
    {
      "@id": "schema:CreativeWork"
    }
  ]
  },
  {
  "@id": "connoss:developerDocumentation",
  "@type": "rdf:Property",
  "rdfs:comment": "Documentation for developers, maintainers, and infrastructure people.",
  "rdfs:label": "developer documentation",
  "rdfs:subPropertyOf": {
    "@id": "connoss:documentation"
  },
  "schema:domainIncludes": {
    "@id": "connoss:Software"
  },
  "schema:rangeIncludes": [
    {
      "@id": "schema:CreativeWork"
    }
  ]
    },
    {
      "@id": "connoss:softwareInterface",
      "@type": "rdf:Property",
      "rdfs:comment": "The interaction interface (or software product) through which users or other software systems can access, execute, or integrate this software (e.g., CLI, GUI, WebUI, Notebook, API, Library).",
      "rdfs:label": "software interface",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [ { "@id": "schema:DefinedTerm" }, {"@id": "schema:Text"}, {"@id": "Thing"}, {"@id": "schema:URL"} ]
    },
     {
      "@id": "connoss:testedWith",
      "@type": "rdf:Property",
      "rdfs:comment": "Links the software to a testing activity describing how the software is validated, including the test type, required inputs, and test instructions.",
      "rdfs:label": "tested with",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "connoss:TestAction"
        }
      ]
    },
    {
      "@id": "connoss:TestAction",
      "@type": "rdfs:Class",
      "rdfs:comment": "The act of testing the software according to its specifications, capturing the object tested, the resulting test report or outcome, and the type of test performed.",
      "rdfs:label": "Test Action",
      "rdfs:subClassOf": { "@id": "schema:Action" },
      "owl:equivalentClass": { "@id": "maSMP:SoftwareTestAction" }
    },
    {
      "@id": "connoss:testInput",
      "@type": "rdf:Property",
      "rdfs:comment": "Input used to performed the test. Some tests may not require any input, some may require multiple ones. If order or grouping is important in the case of multiple inputs, a ListItem could help.",
      "schema:domainIncludes": { "@id": "connoss:TestAction" },
      "schema:rangeIncludes": [{ "@id": "schema:Thing" }, { "@id": "schema:ListItem" }],
      "owl:equivalentProperty": { "@id": "maSMP:testInput" }
    },
    {
      "@id": "connoss:testInstructions",
      "@type": "rdf:Property",
      "rdfs:comment": "Specific test instructions for testing the software.",
      "schema:domainIncludes": { "@id": "connoss:TestAction" },
      "schema:rangeIncludes": [{ "@id": "schema:text" }, { "@id": "schema:CreativeWork" }]
    },
    { 
      "@id": "connoss:testType",
      "@type": "rdf:Property",
      "rdfs:comment": "The type of test that it is performed on the object.",
      "rdfs:label": "test type",
      "schema:domainIncludes": { "@id": "connoss:TestAction" },
      "schema:rangeIncludes": [ { "@id": "schema:Text" }, { "@id": "schema:URL" }, { "@id": "schema:DefinedTerm" } ],
      "owl:equivalentProperty": { "@id": "maSMP:testType" }
    },
    {
      "@id": "connoss:implementsSpecification",
      "@type": "rdf:Property",
      "rdfs:comment": "A specification that a software implements, including a standard, API or legally defined level of conformance. e.g., the HTTP standard, the OpenAPI spec, OAuth2.",
      "rdfs:label": "implements specification",
      "schema:domainIncludes": {
      "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:CreativeWork"
        }
      ]
    },
     {
      "@id": "connoss:softwareContainer",
      "@type": "rdf:Property",
      "rdfs:comment": "A container image or packaged runtime environment of the software.",
      "rdfs:label": "software container",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "connoss:input",
      "@type": "rdf:Property",
      "rdfs:comment": "A formal specification of the data, files, or parameters that the software accepts as input, including format, type, and whether the input is required.",
      "rdfs:label": "input",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "bioschemas:FormalParameter"
        }
      ]
    },
    {
      "@id": "connoss:output",
      "@type": "rdf:Property",
      "rdfs:comment": "A formal specification of the data, files, or results that the software produces, including format and type.",
      "rdfs:label": "output",
      "schema:domainIncludes": {
        "@id": "connoss:Software"
      },
      "schema:rangeIncludes": [
        {
          "@id": "bioschemas:FormalParameter"
        }
      ]
    }
  ]
}